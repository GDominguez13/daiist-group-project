# Copy to .env. NEVER commit .env, tokens, personal data or live customer IDs.
# All keys optional for offline demo; a genuine LLM run requires GEMINI_API_KEY.
GEMINI_API_KEY=          # (optional) Gemini API key for genuine tool-using LLM component
GEMINI_MODEL=            # (optional) e.g. gemini-2.5-flash-lite; default selected in pipeline.py
GEMINI_JUDGE_MODEL=      # (optional) judge model, default gemini-2.5-flash-lite
DEMO_MODE=               # (optional) set 1 for no-key tests, but never claim LLM ran
ENABLE_BANDIT=           # (optional) set 1 to learn prompt-variant choice from real thumbs feedback
EVAL_USE_LLM_JUDGE=      # (optional) set 1 for LLM evaluation judge; require human labels
GEMINI_USD_PER_M_INPUT=  # (optional) paid-tier USD per million input tokens; starter default 0.10
GEMINI_USD_PER_M_OUTPUT= # (optional) paid-tier USD per million output tokens; starter default 0.40
USD_TO_EUR=              # (optional) conversion multiplier; starter EXAMPLE 0.90, recheck current rate
BASELINE_MANUAL_MIN_PER_CASE=     # (optional) baseline assumed minutes per case; demo default 4
BASELINE_REVIEW_MIN_PER_CASE=     # (optional) manual review minutes; demo default 4
BASELINE_AUTO_CHECK_MIN_PER_CASE= # (optional) auto case check minutes; demo default 0.5
HF_TOKEN=                # (optional) HF write token to deploy Space and private logging dataset
HF_SPACE=                # (optional) Hugging Face user/space-name to deploy
HF_LOG_REPO=             # (optional) user/private-dataset holding logs across Space restarts
